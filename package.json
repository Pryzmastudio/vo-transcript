{
  "name": "vo-transcript",
  "version": "1.0.1",
  "description": "Drive the real macOS VoiceOver through AppleScript and get a transcript of what it says on a web page. No Full Disk Access, no changes to VoiceOver's settings files.",
  "type": "module",
  "bin": {
    "vo-transcript": "bin/vo-transcript.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/analyze.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "voiceover",
    "screen-reader",
    "accessibility",
    "a11y",
    "applescript",
    "macos",
    "testing",
    "wcag"
  ],
  "author": {
    "name": "Vayle",
    "email": "hello@vayle.art",
    "url": "https://vayle.art"
  },
  "contributors": [
